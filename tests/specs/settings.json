[
  {
    "name": "settings accepts valid quiet hours",
    "steps": [
      { "send": { "callback": "settings:quiet" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send quiet hours as HH:MM-HH:MM, for example 00:00-08:00." } }] },
      { "send": { "text": "22:00-07:00" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Quiet hours are set to 22:00–07:00." } }] }
    ]
  }
]
